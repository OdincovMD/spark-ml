#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

mkdir -p \
  "$repo_root/.sbt-home" \
  "$repo_root/.sbt-cache/global" \
  "$repo_root/.sbt-cache/boot" \
  "$repo_root/.sbt-cache/local" \
  "$repo_root/.ivy2" \
  "$repo_root/.coursier/cache"

export COURSIER_CACHE="$repo_root/.coursier/cache"
export SBT_OPTS="${SBT_OPTS:-} -Duser.home=$repo_root/.sbt-home -Dsbt.global.base=$repo_root/.sbt-cache/global -Dsbt.boot.directory=$repo_root/.sbt-cache/boot -Dsbt.ivy.home=$repo_root/.ivy2 -Dsbt.coursier.home=$repo_root/.coursier -Dsbt.global.localcache=$repo_root/.sbt-cache/local -Dsbt.server.forcestart=true"

cd "$repo_root"
exec sbt --no-server "$@"
